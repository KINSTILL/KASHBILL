generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AccountType {
  PROFESSIONAL
  CONSUMER
}

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum Mode {
  ECOMMERCE
  PRESTATION
}

enum DocType {
  TICKET
  BON_COMMANDE
  BORDEREAU
  DEVIS
  PROFORMA
  FACTURE
  RECU
}

enum SubSource {
  NOTCH_PAY
  ADMIN_GIFT
  REFERRAL
  TRIAL
}

enum AddOnType {
  EXTRA_DEVICE
  CUSTOM_WHATSAPP
  WHITE_LABEL
}

enum Locale {
  FR
  EN
}

enum EInvoiceFormat {
  NONE
  UBL
  CII
  FACTURX
}

enum EInvoiceRegulatoryStatus {
  NONE
  UPCOMING
  MANDATORY
}

enum ReferralStatus {
  PENDING
  ACTIVATED
  REWARDED
  FLAGGED
  REJECTED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

// ─────────────────────────────────────────────
// MODÈLES
// ─────────────────────────────────────────────

model User {
  id                       String      @id @default(cuid())
  phone                    String      @unique
  pinHash                  String
  name                     String?
  businessName             String?
  city                     String?
  locale                   Locale      @default(FR)
  role                     Role        @default(USER)
  accountType              AccountType @default(PROFESSIONAL)
  consumerWaiverAcceptedAt DateTime?
  mode                     Mode        @default(ECOMMERCE)
  proUntil                 DateTime?
  pendingProDays           Int         @default(0)
  referralCode             String      @unique

  // ─── Freemium ───
  duplicationsThisMonth  Int      @default(0)
  renumerationsThisMonth Int      @default(0)
  monthlyCountersResetAt DateTime @default(now())
  productPhotosCount     Int      @default(0)

  // ─── Anti-fraude ───
  bannedAt         DateTime?
  bannedById       String?
  banReason        String?
  suspendedUntil   DateTime?
  suspendReason    String?
  flaggedForReview Boolean   @default(false)
  lastAdminLoginAt DateTime?

  // ─── Informations légales (panafricain) ───
  country      String  @default("CM")
  legalName    String?
  taxId        String?
  rccm         String?
  legalAddress String?
  logoUrl      String?
  signatureUrl String?
  stampUrl     String?
  personalWhatsAppNumber String?
  // Cachet affiché sur les tickets 80 mm (aucune signature sur les tickets)
  showStampOnTicket Boolean @default(false)
  headerText   String?
  footerText   String?
  cgvText      String?
  email        String?
  legalForm    String?

  // ─── Personnalisation des documents (white label uniquement) ───
  brandPrimaryColor String?
  brandAccentColor  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Relations ───
  devices                Device[]
  deviceApprovals        DeviceApproval[]
  recoveryCodes          RecoveryCode[]
  clients                Client[]
  documents              Document[]
  documentSequences      DocumentSequence[]
  subscriptions          Subscription[]
  subscriptionInvoices   SubscriptionInvoice[]
  referralsMade          Referral[]            @relation("ReferralParrain")
  referralReceived       Referral?             @relation("ReferralFilleul")
  fraudFlags             FraudFlag[]           @relation("FraudFlagUser")
  fraudFlagsReviewed     FraudFlag[]           @relation("FraudFlagReviewer")
  blacklistEntries       BlacklistEntry[]
  thresholdsUpdated      FraudThreshold[]
  recurringSchedules     RecurringSchedule[]
  bulkJobs               BulkJob[]
  legalDocumentsAuthored LegalDocument[]       @relation("LegalDocumentAuthor")
  consents               UserConsent[]
  addOns                 UserAddOn[]

  @@index([country])
  @@index([flaggedForReview])
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  userAgent  String?
  lastIp     String?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
}

model DeviceApproval {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  newDeviceId String
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId, consumed, expiresAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

model Client {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  phone              String?
  email              String?
  address            String?
  note               String?
  taxId              String?
  country            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          Document[]
  recurringSchedules RecurringSchedule[]
  bulkJobItems       BulkJobItem[]

  @@index([userId])
}

model Document {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type              DocType
  mode              Mode
  number            String    @unique
  locale            Locale
  payload           Json
  pdfPath           String?
  watermarked       Boolean   @default(true)
  sentViaWhatsAppAt DateTime?
  sentViaEmailAt    DateTime?
  contentHash       String?
  qrCodeUrl         String?
  xmlPayload        String?   @db.Text
  xmlGeneratedAt    DateTime?
  editCount         Int       @default(0)
  retainUntil       DateTime?
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verification  DocumentVerification?
  fraudFlags    FraudFlag[]
  recurringRuns RecurringRun[]
  bulkJobItems  BulkJobItem[]

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([retainUntil])
  @@index([contentHash])
}

model DocumentSequence {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefix     String // ex: "F", "DV", "BC"
  year       Int
  lastNumber Int    @default(0)

  @@unique([userId, prefix, year])
  @@index([userId, prefix])
}

model DocumentVerification {
  id            String    @id @default(cuid())
  documentId    String    @unique
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publicToken   String    @unique
  isAuthentic   Boolean   @default(true)
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([publicToken])
}

model Subscription {
  id                         String               @id @default(cuid())
  userId                     String
  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  source                     SubSource
  startsAt                   DateTime
  endsAt                     DateTime
  providerRef                String?
  amountXaf                  Int?
  addOnType                  AddOnType?
  createdAt                  DateTime             @default(now())
  consumerWithdrawalWaiver   Boolean              @default(false)
  consumerWithdrawalWaivedAt DateTime?
  invoice                    SubscriptionInvoice?
  addOns                     UserAddOn[]

  @@index([userId, endsAt])
}

model Referral {
  id                String         @id @default(cuid())
  parrainId         String
  parrain           User           @relation("ReferralParrain", fields: [parrainId], references: [id], onDelete: Cascade)
  filleulId         String         @unique
  filleul           User           @relation("ReferralFilleul", fields: [filleulId], references: [id], onDelete: Cascade)
  status            ReferralStatus @default(PENDING)
  parrainRewardedAt DateTime?
  filleulRewardedAt DateTime?
  triggeredAt       DateTime?
  fraudFlags        Json?
  parrainIp         String?
  parrainDeviceId   String?
  createdAt         DateTime       @default(now())

  @@index([parrainId, status])
  @@index([filleulId])
}

model CountryTaxConfig {
  id                       String                   @id @default(cuid())
  countryCode              String                   @unique
  countryNameFr            String
  countryNameEn            String
  currency                 String
  taxIdLabel               String
  rccmLabel                String
  vatRate                  Decimal?                 @db.Decimal(5, 2)
  requiredFields           Json
  legalMentionsTemplate    String
  isActive                 Boolean                  @default(true)
  einvoiceFormat           EInvoiceFormat           @default(UBL)
  einvoiceRegulatoryStatus EInvoiceRegulatoryStatus @default(NONE)
  mobileMoneyEnabled       Boolean                  @default(false)
  paymentOperators         Json?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model FraudThreshold {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Int
  description String
  floor       Int
  ceiling     Int
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model FraudFlag {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation("FraudFlagUser", fields: [userId], references: [id], onDelete: SetNull)
  documentId   String?
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reason       String
  details      Json?
  severity     FraudSeverity @default(MEDIUM)
  status       FraudStatus   @default(PENDING)
  autoDetected Boolean       @default(true)
  reviewedById String?
  reviewedBy   User?         @relation("FraudFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())

  @@index([status, severity, createdAt])
  @@index([userId, status])
  @@index([documentId])
}

model BlacklistEntry {
  id          String   @id @default(cuid())
  type        String // "PHONE" | "TAX_ID" | "DOCUMENT_HASH"
  value       String
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([type, value])
  @@index([type])
}

/// Journal append-only : userId/actorId sont de simples identifiants (sans clé étrangère)
/// afin que la suppression d'un compte ne modifie jamais les lignes d'audit.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorId   String?
  targetId  String?
  action    String
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}

model RecurringSchedule {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  docType       DocType
  mode          Mode
  locale        Locale
  payload       Json
  clientId      String?
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  frequency     RecurringFrequency
  nextRunAt     DateTime
  lastRunAt     DateTime?
  isPaused      Boolean            @default(false)
  autoSendWhatsApp Boolean         @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  runs          RecurringRun[]

  @@index([userId, isPaused])
  @@index([nextRunAt, isPaused])
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model RecurringRun {
  id         String            @id @default(cuid())
  scheduleId String
  schedule   RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status     RunStatus
  error      String?
  executedAt DateTime          @default(now())

  @@index([scheduleId, executedAt])
}

model BulkJob {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  docType      DocType
  mode         Mode
  locale       Locale
  payload      Json
  channel      BulkChannel
  status       BulkStatus    @default(PENDING)
  totalCount   Int
  successCount Int           @default(0)
  failCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  items        BulkJobItem[]

  @@index([userId, status])
}

// EMAIL = auto via Resend
// WHATSAPP_LINKS = retourne URLs wa.me (pas d'API)
enum BulkChannel {
  EMAIL // historique : plus utilisé
  WHATSAPP_LINKS // historique : plus utilisé
  WHATSAPP
}

enum BulkStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model BulkJobItem {
  id         String    @id @default(cuid())
  jobId      String
  job        BulkJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  waUrl      String? // rempli si channel WHATSAPP_LINKS
  status     RunStatus @default(SUCCESS)
  error      String?
  executedAt DateTime  @default(now())

  @@index([jobId])
}

enum RunStatus {
  SUCCESS
  FAILED
}

model PlatformInvoiceSequence {
  id         String @id @default(cuid())
  year       Int    @unique
  lastNumber Int    @default(0)
}

model SubscriptionInvoice {
  id             String       @id @default(cuid())
  subscriptionId String       @unique
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  number         String       @unique
  locale         Locale
  amountXaf      Int
  vatRate        Decimal?     @db.Decimal(5, 2)
  vatAmountXaf   Int?
  totalXaf       Int
  paymentRef     String?
  paymentMethod  String
  paidAt         DateTime
  periodStart    DateTime
  periodEnd      DateTime
  pdfPath        String?
  sentByEmailAt  DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([paidAt])
}

model UserAddOn {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AddOnType
  startsAt       DateTime      @default(now())
  endsAt         DateTime
  amountXaf      Int
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([userId, type, endsAt])
}

// ─── Documents Légaux & Consentements ───

enum LegalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LegalDocument {
  id          String      @id @default(cuid())
  slug        String
  version     String
  locale      Locale
  title       String
  content     String      @db.Text
  status      LegalStatus @default(DRAFT)
  effectiveAt DateTime?
  publishedAt DateTime?
  createdById String?
  createdBy   User?       @relation("LegalDocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  consents UserConsent[]

  @@unique([slug, version, locale])
  @@index([slug, status, locale])
  @@index([effectiveAt])
}

model UserConsent {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentSlug    String
  version         String
  legalDocumentId String?
  legalDocument   LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime       @default(now())
  ip              String?
  userAgent       String?

  @@unique([userId, documentSlug, version])
  @@index([userId])
  @@index([documentSlug, version])
}

// ─── FAQ ───

model FAQEntry {
  id          String   @id @default(cuid())
  category    String
  order       Int      @default(0)
  locale      Locale
  question    String
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, locale, order])
  @@index([isPublished])
}

// ─── BLOG ───

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id             String        @id @default(cuid())
  slug           String
  locale         Locale
  title          String
  excerpt        String        @db.Text
  content        String        @db.Text
  coverUrl       String?
  authorName     String
  tags           String[]
  status         ArticleStatus @default(DRAFT)
  category       String        @default("BLOG")
  published      Boolean       @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  readingTime    Int           @default(0)
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([slug, locale])
  @@index([category, locale, published])
  @@index([locale, status, publishedAt])
}

model UnifiedArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  category    String // "BLOG" ou "FAQ"
  locale      String // "fr" ou "en"
  tags        String[]
  published   Boolean  @default(false)
  views       Int      @default(0)
  readingTime Int      @default(0)
  authorName  String   @default("MyCashBill")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, locale, published])
  @@index([locale, published, createdAt])
  @@map("articles_unified")
}
