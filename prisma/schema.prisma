generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  USER
  SUPPORT
  ADMIN
}

enum Mode {
  ECOMMERCE
  PRESTATION
}

enum DocType {
  TICKET
  BON_COMMANDE
  BORDEREAU
  DEVIS
  PROFORMA
  FACTURE
  RECU
}

enum SubSource {
  NOTCH_PAY
  ADMIN_GIFT
  REFERRAL
  TRIAL
}

enum Locale {
  FR
  EN
}

enum ReferralStatus {
  PENDING
  ACTIVATED
  REWARDED
  FLAGGED
  REJECTED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

// ─────────────────────────────────────────────
// MODÈLES
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  phone           String    @unique
  pinHash         String
  name            String?
  businessName    String?
  city            String?
  locale          Locale    @default(FR)
  role            Role      @default(USER)
  mode            Mode      @default(ECOMMERCE)
  proUntil        DateTime?
  pendingProDays  Int       @default(0)
  referralCode    String    @unique

  // ─── Freemium ───
  duplicationsThisMonth   Int      @default(0)
  renumerationsThisMonth  Int      @default(0)
  monthlyCountersResetAt  DateTime @default(now())
  productPhotosCount      Int      @default(0)

  // ─── Anti-fraude ───
  bannedAt         DateTime?
  bannedById       String?
  banReason        String?
  suspendedUntil   DateTime?
  suspendReason    String?
  flaggedForReview Boolean  @default(false)
  lastAdminLoginAt DateTime?

  // ─── Informations légales (panafricain) ───
  country      String  @default("CM")
  legalName    String?
  taxId        String?
  rccm         String?
  legalAddress String?
  logoUrl      String?
  signatureUrl String?
  stampUrl     String?
  headerText   String?
  footerText   String?
  cgvText      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Relations ───
  devices            Device[]
  deviceApprovals    DeviceApproval[]
  recoveryCodes      RecoveryCode[]
  clients            Client[]
  documents          Document[]
  documentSequences  DocumentSequence[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]        @relation("TargetLogs")
  auditLogsAsActor   AuditLog[]        @relation("ActorLogs")
  referralsMade      Referral[]        @relation("ReferralParrain")
  referralReceived   Referral?         @relation("ReferralFilleul")
  fraudFlags         FraudFlag[]       @relation("FraudFlagUser")
  fraudFlagsReviewed FraudFlag[]       @relation("FraudFlagReviewer")
  blacklistEntries   BlacklistEntry[]
  thresholdsUpdated  FraudThreshold[]

  @@index([country])
  @@index([flaggedForReview])
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  userAgent   String?
  lastIp      String?
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
}

model DeviceApproval {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String
  expiresAt    DateTime
  consumed     Boolean   @default(false)
  newDeviceId  String
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId, consumed, expiresAt])
}

model RecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, usedAt])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]

  @@index([userId])
}

model Document {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type              DocType
  mode              Mode
  number            String    @unique
  locale            Locale
  payload           Json
  pdfPath           String?
  watermarked       Boolean   @default(true)
  sentViaWhatsAppAt DateTime?
  contentHash       String?
  qrCodeUrl         String?
  editCount         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verification    DocumentVerification?
  fraudFlags      FraudFlag[]

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([contentHash])
}

model DocumentSequence {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  docType    DocType
  year       Int
  lastNumber Int     @default(0)

  @@unique([userId, docType, year])
}

model DocumentVerification {
  id            String    @id @default(cuid())
  documentId    String    @unique
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  publicToken   String    @unique
  isAuthentic   Boolean   @default(true)
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  @@index([publicToken])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      SubSource
  startsAt    DateTime
  endsAt      DateTime
  providerRef String?
  amountXaf   Int?
  createdAt   DateTime  @default(now())

  @@index([userId, endsAt])
}

model Referral {
  id                String         @id @default(cuid())
  parrainId         String
  parrain           User           @relation("ReferralParrain", fields: [parrainId], references: [id], onDelete: Cascade)
  filleulId         String         @unique
  filleul           User           @relation("ReferralFilleul", fields: [filleulId], references: [id], onDelete: Cascade)
  status            ReferralStatus @default(PENDING)
  parrainRewardedAt DateTime?
  filleulRewardedAt DateTime?
  triggeredAt       DateTime?
  fraudFlags        Json?
  createdAt         DateTime       @default(now())

  @@index([parrainId, status])
  @@index([filleulId])
}

model CountryTaxConfig {
  id                    String   @id @default(cuid())
  countryCode           String   @unique
  countryNameFr         String
  countryNameEn         String
  currency              String
  taxIdLabel            String
  rccmLabel             String
  vatRate               Decimal? @db.Decimal(5, 2)
  requiredFields        Json
  legalMentionsTemplate String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model FraudThreshold {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Int
  description String
  floor       Int
  ceiling     Int
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model FraudFlag {
  id           String        @id @default(cuid())
  userId       String?
  user         User?         @relation("FraudFlagUser", fields: [userId], references: [id], onDelete: SetNull)
  documentId   String?
  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reason       String
  details      Json?
  severity     FraudSeverity @default(MEDIUM)
  status       FraudStatus   @default(PENDING)
  autoDetected Boolean       @default(true)
  reviewedById String?
  reviewedBy   User?         @relation("FraudFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())

  @@index([status, severity, createdAt])
  @@index([userId, status])
  @@index([documentId])
}

model BlacklistEntry {
  id          String   @id @default(cuid())
  type        String   // "PHONE" | "TAX_ID" | "DOCUMENT_HASH"
  value       String
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([type, value])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation("TargetLogs", fields: [userId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)
  targetId  String?
  action    String
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetId, createdAt])
  @@index([action, createdAt])
}
