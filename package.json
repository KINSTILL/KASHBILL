{
  "name": "mycashbill",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.test -- vitest",
    "test:run": "pnpm exec dotenv -e .env.test -- vitest --run",
    "test:coverage": "pnpm exec dotenv -e .env.test -- vitest --run --coverage",
    "test:setup": "pnpm exec dotenv -e .env.test -- pnpm prisma migrate deploy",
    "test:e2e": "pnpm exec dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "pnpm exec dotenv -e .env.test -- playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:all": "pnpm test:run && pnpm test:e2e",
    "audit:security": "node scripts/security-audit.js",
    "audit:lighthouse": "lhci autorun",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:seed:prod": "dotenv -e .env.production -- tsx prisma/seed.ts",
    "db:reset": "pnpm prisma migrate reset --force",
    "db:studio": "pnpm prisma studio",
    "cli:create-admin": "dotenv -e .env.production -- tsx scripts/cli/create-admin.ts",
    "cli:export-user": "dotenv -e .env.production -- tsx scripts/cli/export-user.ts",
    "cli:modify-threshold": "dotenv -e .env.production -- tsx scripts/cli/modify-threshold.ts",
    "cli:remove-blacklist": "dotenv -e .env.production -- tsx scripts/cli/remove-blacklist.ts",
    "cli:migrate-uploads": "dotenv -e .env.production -- tsx scripts/cli/migrate-uploads-encryption.ts",
    "domain:set": "bash scripts/set-domain.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "i18n-iso-countries": "^7.14.0",
    "idb": "^8.0.4",
    "isomorphic-dompurify": "^4.7.0",
    "jose": "^6.2.15",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.37.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.50.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
